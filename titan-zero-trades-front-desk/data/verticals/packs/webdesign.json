  "extra_prompt": "You are booking for a web and graphic design studio. Ask about the project type, scope, deadline, and whether content or branding exists. Ask about platform preferences and hosting. Quote prices only from the reference answers, and say the final price is confirmed after scope is agreed. Do not promise a specific timeline or result that is not in the reference answers.",
  "kb": [
    {
      "q": "How much does a website cost?",
      "a": "{price_note} Websites are priced by page count and features. Tell us your scope and we will send a quote.",
      "keywords": "cost,price,website",
      "priority": 9
    },
    {
      "q": "Do you design logos?",
      "a": "Yes, we design logos and full brand identity packages. Tell us about your business and style, and we will quote the package.",
      "keywords": "design,logos",
      "priority": 8
    },
    {
      "q": "Which platforms do you build on?",
      "a": "We build on WordPress, Shopify, Squarespace and Webflow. We recommend the best platform for your goals before you start.",
      "keywords": "platforms,build",
      "priority": 8
    },
    {
      "q": "Do you build e-commerce stores?",
      "a": "Yes, we build e-commerce stores on Shopify and WooCommerce. Store pricing starts from the rate on your quote.",
      "keywords": "build,e,commerce,stores",
      "priority": 8
    },
    {
      "q": "Do you host websites?",
      "a": "We can recommend hosting or manage it for you. Hosting costs are separate from our design fee.",
      "keywords": "hosting,host",
      "priority": 8
    },
    {
      "q": "Do you do SEO?",
      "a": "We do on-page SEO setup as part of the build. Ongoing SEO is quoted separately.",
      "keywords": "seo,search",
      "priority": 9
    },
    {
      "q": "Do you offer maintenance?",
      "a": "Yes, we offer monthly maintenance plans. Ask us what each plan covers before you join.",
      "keywords": "maintenance",
      "priority": 8
    },
    {
      "q": "Do you do copywriting?",
      "a": "We can work with your copy or recommend a copywriter. Copywriting is priced per page, as listed in our rates.",
      "keywords": "copywriting,copy",
      "priority": 8
    },
    {
      "q": "How long does a website take?",
      "a": "A typical website takes [number] weeks, depending on scope and how quickly content is supplied.",
      "keywords": "how long,time",
      "priority": 9
    },
    {
      "q": "Do you do print design?",
      "a": "Yes, we design brochures, business cards, packaging and signage. Print work is priced per item, as listed in our rates.",
      "keywords": "print,brochure",
      "priority": 8
    },
    {
      "q": "How many revisions are included?",
      "a": "Our packages include [number] rounds of revisions. Extra rounds are quoted separately.",
      "keywords": "revision,changes",
      "priority": 8
    },
    {
      "q": "Do you do UX and UI design?",
      "a": "Yes, we do UX and UI design for websites and mobile apps. We confirm the scope before design starts.",
      "keywords": "ux,ui,design",
      "priority": 8
    },
    {
      "q": "Do you need content from me?",
      "a": "Yes, we need your text and images. We can also arrange content creation at an additional cost.",
      "keywords": "content,text",
      "priority": 8
    },
    {
      "q": "Do you offer payment plans?",
      "a": "{payment_note} We confirm the payment schedule in your quote.",
      "keywords": "payment plan,instalment",
      "priority": 8
    },
    {
      "q": "Are you insured?",
      "a": "Yes, we hold [insurance type] insurance with [insurer]. Certificates are available on request.",
      "keywords": "insured,insurance",
      "priority": 7
    },
    {
      "q": "Do you fix broken websites?",
      "a": "Yes, we fix hacked, broken and slow websites. Tell us what is happening, and we will advise on the fix and cost before work starts.",
      "keywords": "fix,broken,websites",
      "priority": 8
    }
