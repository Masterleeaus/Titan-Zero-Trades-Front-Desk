  "extra_prompt": "You are booking for a marketing agency. Ask about the business, industry, target market, current marketing, and budget. Ask what outcome they want (leads, sales, awareness). Quote prices only from the reference answers, and say the final price is confirmed after strategy. Do not promise specific rankings, lead volumes, or ROAS that is not in the reference answers.",
  "kb": [
    {
      "q": "How much do you charge?",
      "a": "{price_note} We work on monthly retainers or project fees. Tell us your goals and budget, and we will suggest a package.",
      "keywords": "cost,price,charge",
      "priority": 9
    },
    {
      "q": "Do you do SEO?",
      "a": "Yes, we do local and national SEO, including on-page and technical work. We report progress each month so you can see what has changed.",
      "keywords": "seo",
      "priority": 9
    },
    {
      "q": "Do you run Google Ads?",
      "a": "Yes, we set up and manage Google Ads campaigns. We review spend and results regularly and adjust the campaigns to suit.",
      "keywords": "google ads,adwords",
      "priority": 9
    },
    {
      "q": "Do you do Facebook and Instagram ads?",
      "a": "Yes, we run Meta ads on Facebook and Instagram. We set up audiences, creative, and budgets to suit your goals.",
      "keywords": "facebook,instagram,meta",
      "priority": 9
    },
    {
      "q": "Do you manage social media?",
      "a": "Yes, we plan content, schedule posts, and manage community comments. We agree the posting schedule and tone with you first.",
      "keywords": "social media",
      "priority": 9
    },
    {
      "q": "Do you do email marketing?",
      "a": "Yes, we build and send email campaigns. Tell us which email platform you use, such as [your email platform].",
      "keywords": "email,klaviyo,mailchimp",
      "priority": 8
    },
    {
      "q": "Do you write content?",
      "a": "Yes, we write blogs, landing pages, and ad copy. Content is priced per 1000 words, and we confirm the scope before we start.",
      "keywords": "content,copywriting",
      "priority": 8
    },
    {
      "q": "How long until I see results?",
      "a": "Paid ads can show results within the first few weeks. SEO usually takes several months, and we will set realistic milestones with you.",
      "keywords": "how long,results",
      "priority": 9
    },
    {
      "q": "Do you offer a free audit?",
      "a": "{audit_note} Our marketing audit is listed in our price list, and we confirm its scope before you commit.",
      "keywords": "audit,free",
      "priority": 8
    },
    {
      "q": "Do you require a long contract?",
      "a": "{contract_note} We confirm the term and notice period in writing before work starts.",
      "keywords": "contract,term",
      "priority": 9
    },
    {
      "q": "What is your minimum retainer?",
      "a": "{minimum_note} Our monthly retainers start from the amounts in our price list. We confirm the total after we learn your goals.",
      "keywords": "minimum,retainer",
      "priority": 9
    },
    {
      "q": "Do you do lead generation?",
      "a": "Yes, we build landing pages and funnels that capture enquiries. We track each lead so you can see which campaigns bring in enquiries.",
      "keywords": "lead generation,leads",
      "priority": 8
    },
    {
      "q": "Do you set up tracking?",
      "a": "Yes, we set up GA4, Google Tag Manager, and conversion tracking. We check that the tracking records conversions before we hand it over.",
      "keywords": "tracking,analytics,ga4",
      "priority": 8
    },
    {
      "q": "Do you do marketing automation?",
      "a": "Yes, we set up automated email and follow-up workflows. Tell us which tool you use, such as [your CRM or email tool].",
      "keywords": "automation",
      "priority": 7
    },
    {
      "q": "Are you a Google Partner?",
      "a": "{partner_note} If you need proof of our Google qualifications, ask us for [your certification details].",
      "keywords": "partner,certified",
      "priority": 7
    },
    {
      "q": "Do you report on results?",
      "a": "Yes, we send monthly reports and offer a review call. Reports cover the metrics we agreed at the start, such as enquiries and cost per lead.",
      "keywords": "report,reporting",
      "priority": 8
    }
