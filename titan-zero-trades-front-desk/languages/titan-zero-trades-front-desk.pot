#: tzfd-help.inc.php:309
msgid "Approve or decline a booking request"
msgstr ""

#: tzfd-help.inc.php:310
msgid "Go to Booking Orders and open the request."
msgstr ""

#: tzfd-help.inc.php:311
msgid "Change each appointment’s status: Approved to accept it, or a cancelled or rejected status to decline it."
msgstr ""

#: tzfd-help.inc.php:312
msgid "If only some appointments are approved, the customer receives a status update listing each one."
msgstr ""

#: tzfd-help.inc.php:313
msgid "Switch a calendar to request mode"
msgstr ""

#: tzfd-help.inc.php:314
msgid "Go to Settings, then Other settings."
msgstr ""

#: tzfd-help.inc.php:315
msgid "Under Booking intake, choose Request for the calendar, or change the default for calendars that have no setting of their own."
msgstr ""

#: tzfd-help.inc.php:316
msgid "Click Save changes."
msgstr ""

#: tzfd-help.inc.php:317
msgid "Make a test booking in a private browser window. It should show as a request, not a confirmed booking."
msgstr ""

#: tzfd-help.inc.php:322
msgid "Activity Logs"
msgstr ""

#: tzfd-help.inc.php:322
